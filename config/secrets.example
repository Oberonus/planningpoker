# Copy the first section to .kamal/secrets. Store the actual connection string
# locally; never commit it. Percent-encode special characters in the password.
DATABASE_URL=postgres://planningpoker:REPLACE_WITH_APP_PASSWORD@REPLACE_WITH_POSTGRES_CONTAINER:5432/planningpoker?sslmode=disable

# Copy this line to .kamal/database-secrets with a DIFFERENT administrator password.
POSTGRES_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
