# Copy to .env.deploy and fill in your own deployment settings.
# This is sourced as shell code by ./bin/deploy; quote values when necessary.
# Keep passwords in .kamal/secrets and .kamal/database-secrets.
DEPLOY_HOST=vps.example.com
DEPLOY_SSH_USER=deploy
DEPLOY_APP_HOST=poker.example.com

# Preserve these names after initial provisioning to keep using existing data.
DEPLOY_DATABASE_SERVICE=shared-data
DEPLOY_POSTGRES_CONTAINER=shared-postgres
DEPLOY_POSTGRES_VOLUME=shared-postgres-data
